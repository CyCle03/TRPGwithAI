# ===== 서버 설정 =====
# AI 제공자/모델/API 키는 이제 앱 안에서 "사용자별"로 등록합니다 (설정 화면).
# 서버 .env에 AI 키를 둘 필요가 없습니다.

# 세션 토큰·API 키 암호화에 쓰는 시크릿 (선택).
# 미설정 시 서버가 자동 생성해 data/.app_secret 에 저장합니다(재시작/재배포 후에도 유지).
# 여러 서버로 확장하거나 직접 관리하고 싶으면 여기에 긴 랜덤 문자열을 넣으세요.
APP_SECRET=

# 프로덕션에서는 production 으로 (인증 쿠키에 Secure 플래그 적용).
NODE_ENV=production

# 서버 포트
PORT=3000

# 바인딩 주소. 기본 127.0.0.1 — 리버스 프록시(Caddy)가 localhost 로 프록시하는 전제다.
# 컨테이너처럼 외부 인터페이스로 받아야 하는 환경에서만 0.0.0.0 으로 바꿀 것.
# HOST=127.0.0.1

# 운영자 패널(신고 처리·방문 통계) 권한을 가질 계정 아이디.
# ADMIN_USER=elcher

# 저장소에 포함된 샘플 세계관을 넘겨줄 계정 아이디.
# SAMPLE_OWNER=elcher

# ===== 무료 체험 (선택 · 현재 닫혀 있음) =====
# 키가 없는 사용자에게 서버가 부담하는 "무료 체험" 제공자를 열어줍니다.
# LOCAL_LLM_URL 이 비어 있으면 무료 체험 선택지 자체가 노출되지 않습니다.
# OpenAI 호환 /chat/completions 엔드포인트 주소 (예: http://호스트:11434/v1)
# LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=gemma3:4b        # 사고(thinking) 단계가 없는 모델 권장
# LOCAL_LLM_TIMEOUT_MS=180000      # CPU 추론은 느리므로 넉넉히
# LOCAL_LLM_STALL_MS=120000        # 스트리밍 첫 조각이 오지 않을 때 끊는 한도
# LOCAL_LLM_NO_THINK=1             # 0 이면 no-think 지시 비활성
# FREE_TRIAL=off                   # 위 설정을 남겨둔 채 무료 체험만 임시로 닫기
# FREE_LIMIT_PER_HOUR=30           # 사용자별 시간당 호출 수 (동시 사용은 1명 고정)
